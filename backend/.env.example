OPENAI_API_KEY=sk-...

# Architect Model provider selection — "mock" (default, no external calls), "local", or "remote".
# See backend/app/architect/config.py.
ARCHITECT_MODEL_PROVIDER=mock

# Only read when ARCHITECT_MODEL_PROVIDER=local — loads Qwen2.5-Coder-7B-Instruct + the accepted LoRA
# adapter in-process (requires the "local-model" extra: `uv pip install -e ".[local-model]"`). See
# backend/app/architect/local_gateway.py.
ARCHITECT_MODEL_BASE_MODEL_ID=Qwen/Qwen2.5-Coder-7B-Instruct
ARCHITECT_MODEL_ADAPTER_PATH=
ARCHITECT_MODEL_MAX_NEW_TOKENS=2048

# Only read when ARCHITECT_MODEL_PROVIDER=remote — see backend/app/architect/real_gateway.py (its wire
# protocol is still an unconfirmed placeholder, unlike "local"):
ARCHITECT_MODEL_BASE_URL=https://example.invalid/architect-model/v1/generate
ARCHITECT_MODEL_ID=
ARCHITECT_MODEL_API_KEY=
ARCHITECT_MODEL_TIMEOUT_S=30

# Set to 1 to log full Architect Model request payloads (includes user-entered free text). Off by
# default — see backend/app/design/pipeline.py.
BUILDSMART_DEBUG_LOGGING=0

# Project Knowledge RAG — see backend/app/knowledge/config.py.
# KNOWLEDGE_EMBEDDING_PROVIDER=ollama|hash|openai|huggingface (default: auto-detect ollama->hash)
# For real multilingual (Hebrew+English) semantic retrieval, evaluated best-of-3 on this corpus —
# see docs/PROJECT_KNOWLEDGE_RAG.md's embedding evaluation:
#   KNOWLEDGE_EMBEDDING_PROVIDER=huggingface
#   KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-m3
# Requires: uv sync --extra knowledge-embeddings
KNOWLEDGE_EMBEDDING_PROVIDER=
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_EMBEDDING_DEVICE=
KNOWLEDGE_SQLITE_PATH=
KNOWLEDGE_SOURCE_GLOBS=

# Shared by the Knowledge RAG's Ollama embedding provider and the AI test harness's Ollama
# provider. Default (unset) is http://localhost:11434.
OLLAMA_BASE_URL=

# Cheap AI Test Harness — see backend/tests/ai_harness/config.py and docs/AI_TEST_HARNESS.md.
# TEST_MODE: FAST (default) | REGRESSION | LOCAL_AI | FULL_AI | NIGHTLY
TEST_MODE=
AI_TEST_PROVIDER=
AI_TEST_LOCAL_FAST_MODEL=
AI_TEST_LOCAL_STRONG_MODEL=
AI_TEST_PRODUCTION_MODEL=
