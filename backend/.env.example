OPENAI_API_KEY=sk-...

# Architect Model provider selection — "mock" (default, no external calls) or "real".
# See backend/app/architect/config.py and backend/app/architect/real_gateway.py.
ARCHITECT_MODEL_PROVIDER=mock

# Only read when ARCHITECT_MODEL_PROVIDER=real:
ARCHITECT_MODEL_BASE_URL=https://example.invalid/architect-model/v1/generate
ARCHITECT_MODEL_ID=
ARCHITECT_MODEL_API_KEY=
ARCHITECT_MODEL_TIMEOUT_S=30

# Set to 1 to log full Architect Model request payloads (includes user-entered free text). Off by
# default — see backend/app/design/pipeline.py.
BUILDSMART_DEBUG_LOGGING=0
