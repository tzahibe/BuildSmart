exports[`PlanCanvas (DemoPlan) > renders the same SVG for the same design — a snapshot guard while quality UI is added around it 1`] = `"<svg class="demo-plan" viewBox="-1.5 -1.5 15 13" role="img" aria-label="תוכנית אדריכלית"><rect x="0" y="0" width="12" height="10" class="demo-plot"></rect><rect x="0" y="9" width="12" height="1" class="demo-garden"></rect><rect x="4" y="9" width="1.5" height="1" class="demo-walk"></rect><g><rect x="1" y="9.2" width="2.5" height="5" class="demo-parking"></rect><text x="2.25" y="11.7" class="demo-parking-label">P</text></g><rect x="1" y="1" width="10" height="8" class="demo-footprint"></rect><text class="demo-room-label"><tspan x="3.6" y="2.58" class="demo-room-name" style="font-size: 0.52px;">סלון</tspan><tspan x="3.6" y="3.16" class="demo-room-dims" style="font-size: 0.4px;"><tspan class="demo-room-dim-pair" direction="ltr" unicode-bidi="isolate">5.00 × 4.00</tspan> מ׳</tspan><tspan x="3.6" y="3.68" class="demo-room-area" style="font-size: 0.4px;">20.0 מ״ר</tspan></text><text class="demo-room-label"><tspan x="8.6" y="2.58" class="demo-room-name" style="font-size: 0.52px;">חדר שינה</tspan><tspan x="8.6" y="3.16" class="demo-room-dims" style="font-size: 0.4px;"><tspan class="demo-room-dim-pair" direction="ltr" unicode-bidi="isolate">5.00 × 4.00</tspan> מ׳</tspan><tspan x="8.6" y="3.68" class="demo-room-area" style="font-size: 0.4px;">20.0 מ״ר</tspan></text><line x1="6" y1="1" x2="6" y2="5" stroke="#8b939c" stroke-width="0.1" stroke-linecap="butt"></line><g class="demo-layout"></g><g><line x1="6" y1="2.55" x2="6" y2="3.45" class="demo-door"></line><path d="M 6 2.55 A 0.9 0.9 0 0 1 6.9 3.9" class="demo-door-arc"></path><line x1="6" y1="3.9" x2="6.9" y2="3.9" class="demo-door-leaf"></line></g><g><line x1="2.25" y1="9" x2="3.75" y2="9" class="demo-window"></line><text x="3" y="9.55" class="demo-window-label">1.50</text></g><g class="sketch-svg-compass" data-testid="compass" data-top="N" data-bottom="S" data-right="E" data-left="W" data-north-angle="0" data-handedness="KNOWN" transform="translate(12.65 -0.65)"><title>מצפן: הרחוב למעלה (צפון)</title><g transform="scale(1)"><circle r="0.34" class="sketch-svg-compass-ring"></circle><path d="M 0 -0.23 L 0.08 0.06 L 0 -0.03 L -0.08 0.06 Z" class="sketch-svg-compass-needle" transform="rotate(0)"></path><text x="0" y="-0.52" class="sketch-svg-compass-letter" data-edge="top">N</text><text x="0" y="0.52" class="sketch-svg-compass-letter" data-edge="bottom">S</text><text x="0.52" y="0" class="sketch-svg-compass-letter" data-edge="right">E</text><text x="-0.52" y="0" class="sketch-svg-compass-letter" data-edge="left">W</text></g></g></svg>"`;
